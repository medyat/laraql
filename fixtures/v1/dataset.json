{
  "description": "Canonical dataset every v1 fixture is computed against. The workbench seeds it; client adapters may mock with it.",
  "sources": {
    "order": {
      "key": "id",
      "columns": {
        "id": {
          "type": "int"
        },
        "code": {
          "type": "id",
          "searchable": true
        },
        "customer": {
          "type": "string",
          "searchable": true
        },
        "status": {
          "type": "select",
          "options": [
            "draft",
            "released",
            "done"
          ],
          "always": true
        },
        "gross_total": {
          "type": "money",
          "currency": "TRY"
        },
        "due_date": {
          "type": "date"
        },
        "created_at": {
          "type": "datetime"
        },
        "note": {
          "type": "text",
          "visible_when": "admin"
        },
        "labels": {
          "type": "multiselect",
          "options": [
            "export",
            "vip",
            "rush"
          ]
        },
        "lines_count": {
          "type": "int",
          "expression": true,
          "filterable": false,
          "sortable": true
        },
        "owner_id": {
          "type": "user",
          "note": "@me resolves to context.user"
        },
        "lines_qty": {
          "type": "int",
          "from": "line_totals.qty",
          "join": "line_totals",
          "note": "sum of line qty via a joined sub-query; params.product_code narrows it to one product"
        }
      },
      "relations": {
        "lines": {
          "source": "order_line",
          "foreign_key": "order_id"
        }
      },
      "params": {
        "product_code": {
          "type": "id"
        }
      },
      "options": [
        "only_done",
        "with_lines",
        "with_bulk_lines",
        "product_codes",
        "with_ability"
      ]
    },
    "order_line": {
      "key": "id",
      "columns": {
        "id": {
          "type": "int"
        },
        "order_id": {
          "type": "int"
        },
        "product_code": {
          "type": "string",
          "searchable": true
        },
        "qty": {
          "type": "int"
        },
        "position": {
          "type": "int"
        },
        "order.code": {
          "type": "id",
          "from": "orders.code",
          "join": "orders",
          "searchable": true
        }
      },
      "relations": {},
      "default_sort": {
        "position": "asc"
      },
      "options": []
    },
    "warehouse": {
      "key": "id",
      "columns": {
        "id": {
          "type": "id",
          "note": "uuid primary key, auto-declared"
        },
        "code": {
          "type": "id",
          "searchable": true
        },
        "name": {
          "type": "string",
          "searchable": true
        },
        "is_active": {
          "type": "bool"
        }
      },
      "relations": {},
      "options": []
    }
  },
